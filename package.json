{
  "name": "leitenden-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "MOCK_API=1 vite dev",
    "build": "vite build && vite build --config vite.jobs.config.ts && vite build --config vite.worker.config.ts && node scripts/check-build.mjs",
    "start": "node build/index.js",
    "check": "svelte-kit sync && node scripts/check.mjs",
    "test": "bun test",
    "format": "prettier --write src test scripts vite vite.config.ts vite.jobs.config.ts vite.worker.config.ts",
    "format:check": "prettier --check src test scripts vite vite.config.ts vite.jobs.config.ts vite.worker.config.ts"
  },
